MAC_RELEASE_APP_NAME=TokenBar
MAC_RELEASE_REPO=y0shua1ee/TokenBar
MAC_RELEASE_BUNDLE_ID=com.y0shua1ee.tokenbar
MAC_RELEASE_VERSION_FILE=version.env
MAC_RELEASE_APPCAST=appcast.xml
MAC_RELEASE_SOURCE_FILES='Scripts/release_artifacts.sh'
MAC_RELEASE_SPARKLE_ACCOUNT=ed25519
MAC_RELEASE_SUPUBLIC_ED_KEY=AGCY8w5vHirVfGGDGc8Szc5iuOqupZSh9pMj/Qs67XI=
# Older shared AGCY Sparkle key fallback. SPARKLE_PRIVATE_KEY_FILE still wins;
# Keychain is used when this local file is absent.
MAC_RELEASE_SIGNING_KEY_FILE='$HOME/Library/CloudStorage/Dropbox/Backup/Sparkle/sparkle-private-key-OBSOLETE-not-for-BlackBar-publickey-AGCY8w5vHirVfGGDGc8Szc5iuOqupZSh9pMj_Qs67XI-2026-05-21.txt'

# Homebrew installs Sparkle as a cask, so its CLI helpers may not be linked into PATH.
for sparkle_bin in /opt/homebrew/Caskroom/sparkle/*/bin /usr/local/Caskroom/sparkle/*/bin; do
  if [[ -x "$sparkle_bin/generate_keys" && -x "$sparkle_bin/sign_update" && -x "$sparkle_bin/generate_appcast" ]]; then
    case ":$PATH:" in
      *":$sparkle_bin:"*) ;;
      *) PATH="$sparkle_bin:$PATH" ;;
    esac
    break
  fi
done

MAC_RELEASE_APP_ZIP='$(tokenbar_app_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_DSYM_ZIP='$(tokenbar_dsym_zip_name "$MARKETING_VERSION" "${ARCHES:-arm64 x86_64}")'
MAC_RELEASE_ARTIFACT_PREFIX='TokenBar-macos-[A-Za-z0-9_+-]+-'
MAC_RELEASE_FEED_URL='https://raw.githubusercontent.com/y0shua1ee/TokenBar/main/appcast.xml'
MAC_RELEASE_DOWNLOAD_URL_PREFIX='https://github.com/y0shua1ee/TokenBar/releases/download/v${MARKETING_VERSION}/'

MAC_RELEASE_PRECHECK='Scripts/lint.sh lint && Scripts/test.sh'
MAC_RELEASE_PACKAGE_CMD='Scripts/sign-and-notarize.sh'
MAC_RELEASE_TAG_SIGNED=1
MAC_RELEASE_TAG_FORCE=1
MAC_RELEASE_GENERATE_APPCAST_ARGS='--maximum-deltas 0'
MAC_RELEASE_EXTRA_ASSET_WAIT_SECONDS=3600
MAC_RELEASE_EXTRA_ASSET_WAIT_INTERVAL=30
MAC_RELEASE_EXTRA_ASSET_PATTERNS='^TokenBarCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-macos-arm64\.tar\.gz\.sha256$
^TokenBarCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-macos-x86_64\.tar\.gz\.sha256$
^TokenBarCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-linux-aarch64\.tar\.gz\.sha256$
^TokenBarCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-linux-x86_64\.tar\.gz\.sha256$
^TokenBarCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-linux-musl-aarch64\.tar\.gz\.sha256$
^TokenBarCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz$
^TokenBarCLI-v${MARKETING_VERSION}-linux-musl-x86_64\.tar\.gz\.sha256$'
